{
    "name": "@vizo-o/phone-package",
    "version": "0.1.14",
    "description": "Phone number utilities for European phone number support",
    "main": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "default": "./dist/src/index.js"
        }
    },
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
        "format": "prettier --write \"src/**/*.{ts,json}\" \"test/**/*.{ts,json}\" \"*.{json,js,mjs}\"",
        "lint": "oxlint src test -c node_modules/@vizo-o/dev-tools/oxlint-config/oxlintrc.node.json",
        "lint:fix": "oxlint src test -c node_modules/@vizo-o/dev-tools/oxlint-config/oxlintrc.node.json --fix",
        "audit:high": "npm audit --audit-level=high",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "pre-release": "node scripts/pre-release.mjs",
        "release": "release-it",
        "release:ci": "npm run pre-release && release-it --ci",
        "format:check": "prettier --check \"src/**/*.{ts,json}\" \"test/**/*.{ts,json}\" \"*.{json,js,mjs}\"",
        "typecheck": "tsc --noEmit",
        "typecheck:native": "tsgo --noEmit 2>/dev/null || tsc --noEmit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vizo-o/phone-package.git"
    },
    "author": "Gilaad Elstein",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/vizo-o/phone-package/issues"
    },
    "homepage": "https://github.com/vizo-o/phone-package#readme",
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "dependencies": {
        "phone": "^3.1.44"
    },
    "overrides": {
        "lodash": ">=4.17.24",
        "brace-expansion": "5.0.8",
        "fast-xml-parser": ">=5.5.7",
        "minimatch": ">=10.2.1",
        "undici": ">=7.28.0 <8.0.0"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/node": "^22.13.10",
        "@typescript/native-preview": "^7.0.0-dev",
        "@vizo-o/dev-tools": "^1.0.64",
        "chalk": "^4.1.2",
        "jest": "^30.2.0",
        "oxlint": "^1.75.0",
        "prettier": "^3.4.2",
        "release-it": "^19.0.3",
        "ts-jest": "^29.4.5",
        "typescript": "~5.8.2"
    }
}
